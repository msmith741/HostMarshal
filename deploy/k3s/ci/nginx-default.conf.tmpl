# Generated in the disposable Pod by initContainer; do not commit a rendered
# file because it contains the temporary protected ingress proof.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 256k;
    proxy_read_timeout 30s;
    proxy_connect_timeout 3s;

    location = /mcp {
        proxy_http_version 1.1;
        proxy_set_header Host "127.0.0.1:8338";
        proxy_set_header X-Forwarded-Proto "https";
        proxy_set_header X-Forwarded-Host "mcp.hmci.example.test";
        proxy_set_header X-HostMarshal-Ingress-Proof "@@INGRESS_PROOF@@";
        proxy_set_header Connection "";
        proxy_pass http://127.0.0.1:8338;
    }
    location = /.well-known/oauth-protected-resource/mcp {
        proxy_http_version 1.1;
        proxy_set_header Host "127.0.0.1:8338";
        proxy_set_header X-Forwarded-Proto "https";
        proxy_set_header X-Forwarded-Host "mcp.hmci.example.test";
        proxy_set_header X-HostMarshal-Ingress-Proof "@@INGRESS_PROOF@@";
        proxy_set_header Connection "";
        proxy_pass http://127.0.0.1:8338;
    }
    location / {
        return 404;
    }
}
